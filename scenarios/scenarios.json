{
  "_note": "Defaults: start_kmh 30, duration_ms 8000, inject_ms 2000. A fault is {type, start, end?, params}. 'expect' is checked by ssb/oracle.py; FTTI comes from the linked requirements.",
  "scenarios": [
    {"id": "SC-01", "key": "command_link_lost", "title": "Command stream lost (planner alive, link down)", "req": ["SR-01", "SR-05"],
     "faults": [{"type": "link_lost", "start": 2000}], "expect": {"reaction": "STOP_IN_LANE", "cause": ["TIMEOUT"], "stop": true, "latched": true}},
    {"id": "SC-02", "key": "crc_corrupt", "title": "Every command has a corrupted CRC (Profile 5)", "req": ["SR-02"],
     "faults": [{"type": "crc_corrupt", "start": 2000}], "expect": {"reaction": "STOP_IN_LANE", "cause": ["E2E_INVALID"], "stop": true, "latched": true}},
    {"id": "SC-03", "key": "counter_frozen", "title": "Alive counter frozen (same frame repeated)", "req": ["SR-02"],
     "faults": [{"type": "counter_frozen", "start": 2000}], "expect": {"reaction": "STOP_IN_LANE", "cause": ["E2E_INVALID"], "stop": true, "latched": true}},
    {"id": "SC-04", "key": "wrong_data_id", "title": "Frames carry another message's data ID (masquerade)", "req": ["SR-02"],
     "faults": [{"type": "wrong_data_id", "start": 2000}], "expect": {"reaction": "STOP_IN_LANE", "cause": ["E2E_INVALID"], "stop": true, "latched": true}},
    {"id": "SC-05", "key": "intermittent_crc", "title": "Every other frame corrupted: errors scattered between good frames", "req": ["SR-02"],
     "faults": [{"type": "crc_corrupt", "start": 2000, "off_ms": 20, "on_ms": 20}], "expect": {"reaction": "STOP_IN_LANE", "cause": ["E2E_INVALID"], "stop": true, "latched": true}},
    {"id": "SC-05b", "key": "intermittent_link", "title": "Link flaps: 45 ms off / 25 ms on", "req": ["SR-01", "SR-02"],
