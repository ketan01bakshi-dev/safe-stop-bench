    {"id": "SC-37b", "key": "jitter_above_period", "title": "FINDING: 30 ms jitter reorders 20 ms frames, so E2E rejects them and the vehicle stops", "req": ["SR-02"], "inject_ms": 0, "no_ftti": true,
