    {"id": "SC-09", "key": "planner_looping", "title": "Planner stuck in a loop, kicking the watchdog every 2 ms", "req": ["SR-04"],
     "faults": [{"type": "kick_fast", "start": 2000}], "expect": {"reaction": "STOP_IN_LANE", "cause": ["WATCHDOG_EARLY"], "stop": true, "latched": true}},
    {"id": "SC-10", "key": "qa_wrong_answer", "title": "Planner alive but answers the watchdog challenge wrongly", "req": ["SR-04"],
