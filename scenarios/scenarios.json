    {"id": "SC-06", "key": "stale_data", "title": "Valid frames, but data 150 ms old (stale timestamp)", "req": ["SR-03"],
     "faults": [{"type": "stale_timestamp", "start": 2000, "age_ms": 150}], "expect": {"reaction": "STOP_IN_LANE", "cause": ["STALE_DATA"], "stop": true, "latched": true}},
    {"id": "SC-07", "key": "clock_drift", "title": "Planner clock drifts 3% (slowly becomes stale)", "req": ["SR-03"], "no_ftti": true,
